# Local dev only: proxy /api to this backend when running `pnpm dev`
# Default in development: http://localhost:8788 (local wrangler worker)
# NUXT_DEV_API_PROXY="http://localhost:8788"

# Local dev service URLs (defaults — auto-resolved by scripts/resolve-dev-services.mjs)
# DEV_ACCOUNTS_URL=http://localhost:8788
# DEV_BSPLUS_URL=http://localhost:8787
# DEV_MAIL_URL=http://localhost:8789

# Public bsplus URL (production default). Local dev uses DEV_BSPLUS_URL when CF_DEV=1.
# BSPLUS_URL=https://betterseqta.org

# Service API key from bsplus Admin → API keys (scopes: surveys:read) — used for founding survey banner status
# BSPLUS_API_KEY=bs_...
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
 
# JWT secret for signing tokens
JWT_SECRET="your_jwt_secret_here"

# SMTP2GO configuration for password reset emails
SMTP2GO_API_KEY="your_smtp2go_api_key_here"
SMTP2GO_FROM_EMAIL="noreply@yourdomain.com"
APP_URL="http://localhost:8788"

# Discord OAuth configuration
DISCORD_CLIENT_ID="130000"
DISCORD_CLIENT_SECRET="Sz....."
DISCORD_REDIRECT_URI="http://localhost:8788/api/oauth/discord/callback"

# Google Calendar OAuth (BetterSEQTA+ extension — server-side token exchange)
GOOGLE_OAUTH_CLIENT_ID="your_client_id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="GOCSPX-your_client_secret"

# Microsoft / Outlook Calendar OAuth (BetterSEQTA+ extension — server-side token exchange)
MICROSOFT_CALENDAR_CLIENT_ID="your_azure_application_client_id"
MICROSOFT_CALENDAR_CLIENT_SECRET="your_azure_client_secret"
MICROSOFT_CALENDAR_REDIRECT_URI="http://localhost:8788/auth/microsoft/calendar/callback"
