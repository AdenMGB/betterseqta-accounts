PORT=8789
# Public URL clients and Zoraxy terminate TLS for (SPA + API)
PUBLIC_ORIGIN=https://accounts.betterseqta.org
# Cloudflare Worker custom domain (HTML assets + remaining API); edge proxies here
WORKER_UPSTREAM=https://worker.accounts.betterseqta.org
REDIS_URL=redis://127.0.0.1:6379
SYNC_FLUSH_INTERVAL_MS=5000
PEERS_CACHE_TTL_SEC=20
SYNC_GET_CACHE_TTL_SEC=15
# Optional: Cloudflare API (ops / future automation — not required for proxy auth)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=